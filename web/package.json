{
  "name": "vat-demo-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "fixtures": "cd .. && PYTHONPATH=src .venv/bin/python -m demo.export_ui",
    "predev": "npm run fixtures",
